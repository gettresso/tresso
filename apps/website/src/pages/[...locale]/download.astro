---
import CodeBlock from '../../components/CodeBlock.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../config/site';
import { localeStaticPaths, pagePath, t, type Locale } from '../../i18n';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const dl = d.download;
const releasesUrl = site.repoUrl ? `${site.repoUrl}/releases/latest` : null;
---

<Base locale={locale} page="download" title={dl.title}>
  <PageHero eyebrow={dl.eyebrow} title={dl.heroTitle} lead={dl.heroLead}>
    {
      releasesUrl && (
        <div class="actions">
          <a class="button button-primary" href={releasesUrl} rel="noopener">
            {dl.releasesLink}
          </a>
        </div>
      )
    }
  </PageHero>

  <section class="platforms-section">
    <div class="container">
      <ul class="platforms">
        {
          dl.platforms.map((platform) => (
            <li class="platform card">
              <div>
                <h2>{platform.name}</h2>
                <p>{platform.text}</p>
              </div>
              <span class:list={['availability', { soon: !platform.available }]}>
                {platform.available ? dl.available : dl.comingSoon}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section install" aria-labelledby="install-title">
    <div class="container">
      <div class="section-head">
        <h2 id="install-title">{dl.installTitle}</h2>
        <p class="lead">{dl.installLead}</p>
      </div>
      <div class="commands">
        <div>
          <h3>{dl.installMac}</h3>
          <CodeBlock code={site.installScripts.unix} />
        </div>
        <div>
          <h3>{dl.installWindows}</h3>
          <CodeBlock code={site.installScripts.windows} />
        </div>
      </div>
      <p class="note">{dl.macNote}</p>
    </div>
  </section>

  <section class="section self-host">
    <div class="container">
      <h2>{dl.selfHostTitle}</h2>
      <p class="lead">{dl.selfHostText}</p>
      <div class="actions">
        <a class="button button-secondary" href={pagePath(locale, 'openSource')}>{dl.selfHostCta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .platforms-section {
    padding-bottom: clamp(64px, 10vw, 112px);
  }

  .platforms {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platform {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
  }

  .platform h2 {
    font-family: var(--font-text);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .platform p {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .availability {
    flex: none;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--pill-fg);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .availability.soon {
    border: 1px dashed color-mix(in srgb, var(--line) 50%, var(--ink-3));
    background: transparent;
    color: var(--ink-3);
  }

  @media (min-width: 720px) {
    .platforms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .platforms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .install {
    border-top: 1px solid var(--line);
  }

  .commands {
    display: grid;
    gap: 24px;
  }

  .commands > div {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .commands h3 {
    font-size: 1rem;
  }

  @media (min-width: 900px) {
    .commands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .note {
    max-width: 760px;
    margin-top: 28px;
    color: var(--ink-2);
  }

  .self-host {
    border-top: 1px solid var(--line);
  }
</style>
