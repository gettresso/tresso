---
/** How far a feature is: shown as text with a neutral shape, never as color. */
import type { Status } from '../i18n/en';

interface Props {
  status: Status;
  label: string;
}

const { status, label } = Astro.props;
---

<span class:list={['status', `status-${status}`]}>
  <span class="shape" aria-hidden="true"></span>
  {label}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .shape {
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
    border-radius: 999px;
  }

  .status-available {
    color: var(--ink-2);
  }

  .status-available .shape {
    background: currentColor;
  }

  .status-review .shape {
    background: currentColor;
    box-shadow: inset 0 0 0 1.5px var(--surface);
  }

  .status-planned .shape {
    border-style: dotted;
  }
</style>
