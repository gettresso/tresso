{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "Tresso",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "create": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 17.5,
          "y": 27.5
        },
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ]
  },
  "bundle": {
    "macOS": {
      "frameworks": [
        "../.sparkle/Sparkle.framework"
      ],
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
