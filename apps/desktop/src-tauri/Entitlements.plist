<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app runs with the hardened runtime. Library validation only accepts code signed with the app's own Team ID,
       and the release is ad-hoc signed (no Team ID) while it loads Sparkle.framework at runtime (src/updates.rs), so
       it is turned off. Drop this once the app is signed with a Developer ID. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
