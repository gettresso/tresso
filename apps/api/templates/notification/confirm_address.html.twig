{% extends 'base.html.twig' %}

{% block title %}Confirm address{% endblock %}

{% block body %}
    <main class="page">
        <div class="brand">
            <svg class="mark" width="32" height="32" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="8.5" height="5" rx="2.5" class="do"/>
                <rect x="12.5" y="4" width="8.5" height="5" rx="2.5" class="delegate"/>
                <rect x="9.5" y="10.5" width="5" height="10" rx="2.5" class="know"/>
            </svg>
            Tresso
        </div>

        <section class="card" aria-labelledby="confirm-title">
            {% if state == 'ask' %}
                <h1 id="confirm-title">Confirm address</h1>
                <p class="lead">Send Tresso notifications to <strong>{{ address }}</strong>?</p>
                <form class="form" method="post">
                    <button type="submit" class="button">Confirm</button>
                </form>
            {% elseif state == 'confirmed' %}
                <h1 id="confirm-title">Address confirmed</h1>
                <p class="lead">Tresso notifications now go to <strong>{{ address }}</strong>.</p>
            {% else %}
                <h1 id="confirm-title">Link no longer works</h1>
                <p class="lead">This link expired, was used already, or another address was chosen since. Choose the address again in Tresso to get a new link.</p>
            {% endif %}
        </section>
    </main>
{% endblock %}
