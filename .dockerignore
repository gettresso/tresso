# Only what the images build from; never local dependencies, caches, keys or environment overrides.
.git
.github
.claude
**/node_modules
**/.env.local
**/.env.*.local
apps/api/vendor
apps/api/var
# Test code: the production image runs with APP_ENV=prod, loads tests/ nowhere (only when@test config does) and
# dumps the autoloader without autoload-dev; development bind-mounts apps/api instead of copying it.
apps/api/tests
apps/api/config/jwt/*.pem
apps/web/dist
apps/desktop/src-tauri/target
apps/desktop/.sparkle
apps/mobile/.expo
compose.override.yaml
