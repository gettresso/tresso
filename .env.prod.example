# Settings for compose.prod.yaml. Copy to .env next to it, fill in every value, and keep the file private.
# Generate a secret with: openssl rand -hex 32
# The API refuses to start while a secret is missing, too short, or one of the repository's development values.
# Put a value that contains $ in single quotes ('like$this'): Docker Compose otherwise reads $ as a variable.

# The release to run, such as 0.4.0 (latest follows every release).
TRESSO_VERSION=latest

# Where the web client and the API are reached: https and the host only, no path or trailing slash. The proxy gets
# HTTPS certificates for both.
TRESSO_WEB_URL=https://mail.example.com
TRESSO_API_URL=https://api.mail.example.com
# Who may call the API from a browser: change the first part to TRESSO_WEB_URL with its dots escaped; keep the desktop
# app's two origins and the single quotes.
CORS_ALLOW_ORIGIN='^(https://mail\.example\.com|tauri://localhost|http://tauri\.localhost)$'

# Secrets: generate each one, never reuse them.
APP_SECRET=
OAUTH_PASSPHRASE=
OAUTH_ENCRYPTION_KEY=
SYNC_WORKER_CLIENT_SECRET=
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
MEILISEARCH_KEY=
# The database password only applies when the database is first made; changing it later needs ALTER USER as well.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=tresso
S3_SECRET_KEY=

# The key that encrypts mail at rest, as "id:base64 of 32 bytes". Generate one with:
#   echo "k1:$(openssl rand -base64 32)"
# Losing it loses the mail it encrypted: keep a copy outside this server.
DATA_KEYS=
DATA_KEY_CURRENT=k1

# Notifications and sign-in mail go out through this mail server.
MAILER_DSN='smtp://user:password@smtp.example.com:587'
NOTIFICATIONS_FROM=Tresso <tresso@example.com>

# Optional: refuse attachments that could not be scanned instead of warning (1), sign in with Google and Microsoft,
# push notifications (keys from: docker compose -f compose.prod.yaml exec api php bin/console app:notifications:vapid-keys)
# and leave-now travel times.
ATTACHMENTS_REQUIRE_SCAN=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:tresso@example.com
EXPO_ACCESS_TOKEN=
ROUTING_OSRM_URL=
ROUTING_OSRM_BIKE_URL=
ROUTING_OSRM_FOOT_URL=
GEOCODER_NOMINATIM_URL=
