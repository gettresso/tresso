+
+// protect lets a request through only with the bridge's token (when WHATSAPP_BRIDGE_TOKEN is set) and a JSON body.
+// The API has no other check, and anything on this computer reaches 127.0.0.1: another program, and a web page in a
+// browser through a no-cors POST (which can send neither this header nor a JSON content type).
+func protect(next http.Handler, token string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if token != "" && subtle.ConstantTimeCompare([]byte(r.Header.Get("X-Bridge-Token")), []byte(token)) != 1 {
+			http.Error(w, "Unauthorized", http.StatusUnauthorized)
+			return
+		}
+		if mediaType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type")); err != nil || mediaType != "application/json" {
+			http.Error(w, "Content-Type must be application/json", http.StatusUnsupportedMediaType)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
 }
 
