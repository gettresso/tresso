{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# Hashed build files never change. A missing one is a 404, never index.html: a page from an older release must
	# fail to load its files instead of caching an HTML page as JavaScript for a year.
	handle /assets/* {
		@present file
		@missing not file
		header @present Cache-Control "public, max-age=31536000, immutable"
		header @missing Cache-Control "no-store"
		file_server
	}

	# The API address, from the container's TRESSO_API_URL; never cached, so a changed address applies at once.
	handle /config.js {
		header Cache-Control "no-store"
		templates {
			mime text/javascript application/javascript
		}
		file_server
	}

	# Everything else is the app, which routes in the browser: always revalidated, so an upgrade applies on reload.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
